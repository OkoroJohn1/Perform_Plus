# Copy to .env and fill in real values — .env is gitignored, this file
# documents what's required.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Google Cloud "Web application" OAuth client ID, registered on Supabase's
# Google provider page. Required for native Google sign-in on Android/iOS.
# See AGENTS.md's "Google sign-in setup" section.
GOOGLE_WEB_CLIENT_ID=

# Sentry DSN for crash/error reporting (create a free project at sentry.io).
# Left blank, Sentry is never initialized -- the app runs exactly as before,
# it's not a hard dependency. See AGENTS.md's crash-monitoring note.
SENTRY_DSN=
